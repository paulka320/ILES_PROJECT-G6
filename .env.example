# Copy to .env and fill values for production
SECRET_KEY=replace-this-with-a-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres connection (used by docker-compose)
POSTGRES_DB=ILES_G6_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Alternatively provide DATABASE_URL
# DATABASE_URL=postgres://postgres:postgres@db:5432/ILES_G6_db
