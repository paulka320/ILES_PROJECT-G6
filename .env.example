# Copy to .env for local development or set these in Render dashboard.

# Django
SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS / CSRF — set your frontend URL(s), comma-separated (no trailing slash)
# Example after deploy:
# CORS_ALLOWED_ORIGINS=https://iles-frontend.onrender.com
# CSRF_TRUSTED_ORIGINS=https://iles-frontend.onrender.com

# Postgres (local Docker)
POSTGRES_DB=ILES_G6_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Render provides DATABASE_URL automatically when linked to a Postgres instance.
# DATABASE_URL=postgres://user:password@host:5432/dbname
